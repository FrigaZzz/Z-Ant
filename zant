#!/usr/bin/env bash

# zant - A shell wrapper for ONNX Python tools
# Usage: ./zant <script> [flags]

set -e

# Script configurations using arrays instead of associative arrays for better compatibility
get_script_path() {
    case "$1" in
        onnx_gen) echo "tests/CodeGen/Python-ONNX/onnx_gen.py" ;;
        user_tests_gen) echo "tests/CodeGen/user_tests_gen.py" ;;
        shape_thief) echo "src/onnx/shape_thief.py" ;;
        input_setter) echo "src/onnx/input_setter.py" ;;
        onnx_extract) echo "tests/CodeGen/onnx_node_extractor.py" ;;
        create) echo "create" ;;
        *) echo "" ;;
    esac
}

get_script_description() {
    case "$1" in
        onnx_gen) echo "Generate fuzzed ONNX models and save execution data in JSON" ;;
        user_tests_gen) echo "Run ONNX model multiple times with random inputs and save execution data" ;;
        shape_thief) echo "Upgrade your model with all intermediate tensor's shapes" ;;
        input_setter) echo "Set input shape and infer shapes of the ONNX model" ;;
        onnx_extract) echo "For a N nodes model it creates N onnx models, one for each node with respective tests." ;;
        create) echo "Run complete model processing pipeline" ;;
        *) echo "Unknown script" ;;
    esac
}

get_script_flags() {
    case "$1" in
        onnx_gen)
            echo "  --iterations    Number of models to generate for each operation (default: 1)"
            echo "  --seed          Seed for random generation (for reproducibility)"
            echo "  --output-dir    Directory to save generated models (default: datasets/oneOpModels)"
            echo "  --metadata-file File to save metadata and execution data (default: datasets/oneOpModels/results.json)"
            echo "  --op            Name of the operation you want to generate and test (default: all)"
            ;;
        user_tests_gen)
            echo "  --model         Your ONNX model (required)"
            echo "  --iterations    Number of randomized inference runs (default: 1)"
            ;;
        shape_thief)
            echo "  --model         Name of your model (required)"
            ;;
        input_setter)
            echo "  --model         Name of your model (required)"
            echo "  --shape         Input shape as comma-separated values, e.g., 1,3,34,34 (required)"
            ;;
        onnx_extract)
            echo "  --model         Name of your model (required)"
            ;;
        create)
            echo "  --target        Target architecture (e.g., x86_64-linux, aarch64-linux)"
            echo "  --cpu           Target CPU (e.g., cortex_m33, generic)"
            echo "  --optimize      Optimization level (Debug, ReleaseFast, ReleaseSafe, ReleaseSmall)"
            echo "  --skip-extract  Skip node extraction and testing"
            echo "  --skip-user-tests Skip user test generation and usage"
            ;;
    esac
}

# Function to print general usage
print_usage() {
    echo "zant - A shell wrapper for ONNX Python tools"
    echo ""
    echo "Usage: ./zant <script> [flags]"
    echo ""
    echo "Available scripts:"
    for script in onnx_gen user_tests_gen shape_thief input_setter onnx_extract create; do
        printf "  %-15s - %s\n" "$script" "$(get_script_description "$script")"
    done
    echo ""
    echo "To see flags for a specific script:"
    echo "  ./zant <script> --help"
    echo ""
    echo "Examples:"
    echo "  ./zant create mnist-8"
    echo "  ./zant onnx_gen --iterations 5 --seed 42"
    echo "  ./zant user_tests_gen --model my_model --iterations 10"
    echo "  ./zant shape_thief --model model"
    echo "  ./zant input_setter --model model --shape 1,3,224,224"
}

# Function to print script-specific usage
print_script_usage() {
    local script="$1"
    
    # Special handling for create command
    if [[ "$script" == "create" ]]; then
        if [[ -f "./create" ]]; then
            ./create --help
        else
            echo "Error: create script not found"
            exit 1
        fi
        return
    fi
    
    echo "zant $script - $(get_script_description "$script")"
    echo ""
    echo "Usage: ./zant $script [flags]"
    echo ""
    echo "Flags:"
    get_script_flags "$script"
    echo ""
    echo "Python script location: $(get_script_path "$script")"
}

# Function to validate if script exists
validate_script() {
    local script="$1"
    local script_path=$(get_script_path "$script")
    if [[ -z "$script_path" ]]; then
        echo "Error: Unknown script '$script'"
        echo ""
        print_usage
        exit 1
    fi
}

# Function to check if Python script file exists
check_script_file() {
    local script="$1"
    
    # Skip file check for create command
    if [[ "$script" == "create" ]]; then
        return 0
    fi
    
    local script_path=$(get_script_path "$script")
    
    if [[ ! -f "$script_path" ]]; then
        echo "Error: Python script not found: $script_path"
        echo "Make sure you're running this from the correct directory."
        exit 1
    fi
}

# Main execution function
execute_script() {
    local script="$1"
    shift  # Remove script name from arguments
    
    # Special handling for create command
    if [[ "$script" == "create" ]]; then
        if [[ ! -f "./create" ]]; then
            echo "Error: create.sh script not found in current directory"
            exit 1
        fi
        
        chmod +x ./create
        exec ./create "$@"
        return
    fi
    
    local script_path=$(get_script_path "$script")
    local python_cmd="python3"
    
    # Check if python3 is available, fallback to python
    if ! command -v python3 >/dev/null 2>&1; then
        if command -v python >/dev/null 2>&1; then
            python_cmd="python"
        else
            echo "Error: Neither python3 nor python found in PATH"
            exit 1
        fi
    fi
    
    # Build the command
    local cmd=("$python_cmd" "$script_path")
    
    # Add all remaining arguments
    cmd+=("$@")
    
    # Print the command being executed
    echo "Executing: ${cmd[*]}"
    echo ""
    
    # Execute the command
    exec "${cmd[@]}"
}

# Main script logic
main() {
    # Check if any arguments provided
    if [[ $# -eq 0 ]]; then
        print_usage
        exit 1
    fi
    
    local script="$1"
    
    # Handle help flags
    if [[ "$script" == "--help" || "$script" == "-h" ]]; then
        print_usage
        exit 0
    fi
    
    # Validate script exists
    validate_script "$script"
    
    # Check for script-specific help
    if [[ $# -eq 2 && ("$2" == "--help" || "$2" == "-h") ]]; then
        print_script_usage "$script"
        exit 0
    fi
    
    # Check if script file exists
    check_script_file "$script"
    
    # Execute the script with remaining arguments
    execute_script "$@"
}

# Run main function with all arguments
main "$@"